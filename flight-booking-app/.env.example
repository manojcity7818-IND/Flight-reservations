# Local development defaults. Copy to .env if you want to override compose values.
# Do not put real secrets, Azure credentials, or payment keys here.

# Frontend
VITE_API_BASE=/api

# Service-to-service URLs used by the API gateway (Docker Compose service names)
FLIGHT_SEARCH_URL=http://flight-search-service:8000
BOOKING_SERVICE_URL=http://booking-service:8000
PAYMENT_SERVICE_URL=http://payment-service:8000
NOTIFICATION_SERVICE_URL=http://notification-service:8000
USER_SERVICE_URL=http://user-service:8000

# Optional: force payment simulation default (SUCCESS | FAILED)
PAYMENT_DEFAULT_OUTCOME=SUCCESS
